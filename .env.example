# ─────────────────────────────────────────────────────────────────────────────
# Vestry configuration. Copy to .env.local and fill in what you need.
# EVERYTHING here is optional: with no variables set, Vestry runs in demo mode
# (data in the browser, on-device background removal, on-device stylist).
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloud accounts & sync (Supabase, free tier) ─────────────────────────────
# Enables sign-up/login, Postgres storage with row-level security, private image storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed solely for "Delete account" (deletes the auth user + images).
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloud AI for garment tagging + AI stylist (optional) ────────────────────
# Pick ONE. If both are set, Claude is used unless AI_PROVIDER=gemini.
# Without either, tagging uses on-device colour measurement + shape estimates,
# and the on-device rules stylist is used. Nothing is faked.
# claude | gemini | none
AI_PROVIDER=

# Anthropic Claude (paid API, pay-as-you-go):
ANTHROPIC_API_KEY=
# e.g. claude-haiku-5-5 for much lower cost per photo
ANTHROPIC_MODEL=claude-opus-5-5

# Google Gemini (has a free tier with daily limits):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Per-user (cloud mode) or per-IP (demo deployments) hourly limits for AI routes.
AI_ANALYZE_LIMIT_PER_HOUR=60
AI_STYLIST_LIMIT_PER_HOUR=30

# ── Optional server-side background removal (remove.bg) ─────────────────────
# On-device removal is the default and is free. remove.bg's free plan includes a
# small number of credits per month. Users opt in under Settings.
REMOVE_BG_API_KEY=
BG_LIMIT_PER_HOUR=30

# ── On-device model hosting ─────────────────────────────────────────────────
# By default `npm install` copies the background-removal model (~200 MB incl.
# WASM runtimes) into public/bg-models so it is self-hosted. If your host limits
# deployment size, set SKIP_BG_MODELS=1 at install time and point the browser at
# the matching public CDN instead:
# SKIP_BG_MODELS=1
# NEXT_PUBLIC_BG_MODEL_URL=https://staticimgly.com/@imgly/background-removal-data/1.4.5/dist/
