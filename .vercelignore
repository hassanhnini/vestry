# The Vercel CLI uploads the working directory and does not apply .gitignore, so the
# self-hosted background-removal model (~200 MB, regenerated by `npm install`) would be
# uploaded from a developer's disk and sit in the deployment unused. Hosted builds set
# SKIP_BG_MODELS=1 and point the browser at a CDN instead — see README ▸ Deployment.
public/bg-models

# Never upload local build output or secrets; Vercel builds from source.
.next
node_modules
.env
.env.*
